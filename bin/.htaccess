# Défense en profondeur : bin/create_user.php se protège déjà lui-même
# (il refuse de s'exécuter hors CLI), mais on bloque aussi l'accès HTTP
# direct au dossier, au cas où d'autres scripts CLI y seraient ajoutés
# plus tard sans cette précaution.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
